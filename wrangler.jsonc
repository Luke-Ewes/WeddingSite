{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wedding-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}