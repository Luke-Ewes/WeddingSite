AuthType Basic
AuthName "Website"
AuthUserFile /mnt/rid/11/99/530151199/htdocs/.htpasswd
Require valid-user

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^index\.html$ - [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>